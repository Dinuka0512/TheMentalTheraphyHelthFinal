<AnchorPane prefHeight="546.0" prefWidth="926.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.thementaltheraphyhelthfinal.controller.ManageTherapySessionContro">
   <children>
      <Label layoutX="24.0" layoutY="24.0" prefHeight="27.0" prefWidth="289.0" text="Manage Session">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TableView fx:id="tblSession" layoutX="24.0" layoutY="302.0" onMouseClicked="#gettableDetails" prefHeight="216.0" prefWidth="889.0">
         <columns>
            <TableColumn fx:id="colId" prefWidth="55.0" text="ID" />
            <TableColumn fx:id="colPatientId" prefWidth="86.0" text="Patient ID" />
            <TableColumn fx:id="colPatientName" prefWidth="164.0" text="Patient Name" />
            <TableColumn fx:id="colProId" prefWidth="64.0" text="Pro.ID" />
            <TableColumn fx:id="colProName" prefWidth="136.0" text="Program Name" />
            <TableColumn fx:id="colProFee" prefWidth="103.0" text="Fee" />
            <TableColumn fx:id="colTherapistId" prefWidth="63.0" text="T.ID" />
            <TableColumn fx:id="colTherapistName" prefWidth="121.0" text="Therapist name" />
            <TableColumn fx:id="colDate" prefWidth="96.0" text="Date" />
         </columns>
      </TableView>
      <AnchorPane layoutX="24.0" layoutY="53.0" prefHeight="245.0" prefWidth="889.0" style="-fx-background-radius: 10; -fx-background-color: B5A8D5;">
         <children>
            <Label layoutX="22.0" layoutY="45.0" text="Patient" textFill="WHITE" />
            <ComboBox fx:id="comboPatient" layoutX="22.0" layoutY="66.0" onAction="#selectPatient" prefHeight="34.0" prefWidth="265.0" promptText="Select Patient">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ComboBox>
            <Button fx:id="btnSave" layoutX="786.0" layoutY="146.0" mnemonicParsing="false" onAction="#save" prefHeight="34.0" prefWidth="73.0" style="-fx-background-color: white; -fx-border-radius: 10; -fx-border-color: 10;" text="Save" textFill="GREEN">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="btnUpdate" layoutX="703.0" layoutY="146.0" mnemonicParsing="false" onAction="#update" prefHeight="34.0" prefWidth="73.0" style="-fx-background-color: white; -fx-background-radius: 5;" text="Update" textFill="BLUE">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="btnDelete" layoutX="621.0" layoutY="146.0" mnemonicParsing="false" onAction="#delete" prefHeight="34.0" prefWidth="73.0" style="-fx-background-color: white; -fx-background-radius: 5;" text="Delete" textFill="RED">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="btnReset" layoutX="618.0" layoutY="186.0" mnemonicParsing="false" onAction="#reset" prefHeight="34.0" prefWidth="242.0" style="-fx-background-color: white; -fx-background-radius: 5;" text="Reset" textFill="#1d2b43">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Label layoutX="300.0" layoutY="44.0" text="Program " textFill="WHITE" />
            <ComboBox fx:id="comboProgram" layoutX="300.0" layoutY="65.0" onAction="#selectProgram" prefHeight="34.0" prefWidth="265.0" promptText="Select Program">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ComboBox>
            <Label layoutX="22.0" layoutY="21.0" text="Session Id :" textFill="WHITE" />
            <Label fx:id="lblId" layoutX="105.0" layoutY="19.0" text="S001" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <Label fx:id="lblPatientName" layoutX="25.0" layoutY="102.0" prefHeight="21.0" prefWidth="265.0" text="Sample name" textFill="#4400ff" />
            <Label fx:id="lblProgramName" layoutX="300.0" layoutY="101.0" prefHeight="21.0" prefWidth="265.0" text="Program name" textFill="#4400ff" />
            <Label layoutX="300.0" layoutY="128.0" text="Full payment : " textFill="WHITE" />
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="71.0" layoutX="300.0" layoutY="149.0" stroke="WHITE" strokeType="INSIDE" width="304.0" />
            <Label fx:id="lblFee" alignment="CENTER" contentDisplay="CENTER" layoutX="331.0" layoutY="159.0" prefHeight="52.0" prefWidth="242.0" text="19000/=" textFill="#8d0000">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label fx:id="lblTherapistName" layoutX="584.0" layoutY="101.0" prefHeight="21.0" prefWidth="265.0" text="Therapist name" textFill="#4400ff" />
            <Label layoutX="582.0" layoutY="44.0" text="Therapist " textFill="WHITE" />
            <ComboBox fx:id="comboTherapist" layoutX="584.0" layoutY="66.0" onAction="#selectTherapist" prefHeight="34.0" prefWidth="265.0" promptText="Select Therapist">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ComboBox>
            <DatePicker fx:id="txtdateSelect" layoutX="25.0" layoutY="158.0" onAction="#selectTheDate" prefHeight="34.0" prefWidth="265.0" />
            <Label layoutX="25.0" layoutY="135.0" text="Session Date Arange :" textFill="WHITE" />
            <Label fx:id="lblBooked" layoutX="25.0" layoutY="197.0" prefHeight="21.0" prefWidth="211.0" text="Booked the Another session" textFill="#ff4747" visible="false" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
