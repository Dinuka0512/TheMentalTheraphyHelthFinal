            <TableColumn fx:id="colAddress" prefWidth="153.0" text="Address" />
            <TableColumn fx:id="colEmail" prefWidth="125.0" text="Email" />
            <TableColumn fx:id="colContact" prefWidth="84.0" text="Contact" />
            <TableColumn fx:id="colJobRole" prefWidth="85.0" text="Job Role" />
